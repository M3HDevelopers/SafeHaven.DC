# --- SafeHaven backend configuration ---
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/safehaven

# Secret used to sign JWT tokens — change this!
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (frontend default expects 5000)
PORT=5000

# Optional SMTP for forgot-password emails (leave empty to log tokens to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SafeHaven <alerts@safehaven.local>
